APP_NAME=SafeGas AI API
APP_VERSION=1.0.0
DEBUG=True

DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/safegas_db

JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GEMINI_API_KEY=your_gemini_api_key
 
# Comma-separated list of allowed frontend origins (defaults to localhost origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com
