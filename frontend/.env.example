# ── SafeGas AI Frontend Configuration ──────────────────────────────
# In local development: leave unset (defaults to /api/v1 routed via Vite proxy to http://localhost:8000)
# In production (Vercel): Set VITE_API_BASE_URL to your deployed Render backend URL (e.g., https://safegas-backend.onrender.com)
VITE_API_BASE_URL=https://<your-backend-service>.onrender.com
# VITE_API_URL is also supported as a backward-compatible fallback
# VITE_API_URL=https://<your-backend-service>.onrender.com

# ── HPGas Booking Refill Number ──────────────────────────────────
# Optional fallback phone number for cylinder refill booking calls
VITE_HP_GAS_REFILL_NUMBER=+919493602222
